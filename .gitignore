node_modules/
dist/
dist-mobile/
*.log
.DS_Store
.vite/

# 打包产物（322MB，不该进仓库；由 npm run pack 本地生成）
release/
# 手机端启动器产物（本地便利产物，不随 Release 上传）
release-mobile/

# 临时/缓存
#
# 用 `.tmp-*` 而不是逐个枚举：之前是 .tmp-yuki/ .tmp-install/ .tmp-s/ … 一串
# 具体名字，**每新建一个临时目录就得记得回来加一条**，漏一次就会被提交。
# 实测踩过：调试用的 `.tmp-smoke.diff` 没被覆盖，`git add -A` 会把它带进去。
#
# 注意用 `.tmp-*` 而非 `.tmp*/` —— 后者只匹配目录，
# 像 `.tmp-smoke.diff` / `.tmp-open-mobile.cjs` 这种**文件**会漏掉。
.tmp-*
*.tmp

# 本地数据库（正常在 %APPDATA%\desk-pet\，仓库内不该出现；
# 但调试时若把 DB 建在工作区，这条防呆能拦住它进仓库）
*.db
*.db-wal
*.db-shm

# 素材换代时的备份目录（历史遗留的防呆规则，实际已清理干净）
.backup-*/

# 本地环境
.env
.env.*

# Tauri / Rust 本地产物（src-tauri/target 为 Rust 构建产物，数百 MB；
# gen/schemas 为 tauri-build 生成物，随构建再生）
src-tauri/target/
src-tauri/gen/

# Mimosa 安全扫描的本地工作目录
.mimosa/

# 预览脚本的临时启动器（被杀进程时会残留）
.tmp-open-mobile.cjs
# Electron 打包暂存区（绿色版 zip 的压缩来源，交付物只有 zip）
.tmp-release/
# pack:mobile 的暂存目录（内含完整 Electron 运行时，数百 MB）
.tmp-launcher/
