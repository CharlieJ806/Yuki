{
  "name": "desk-pet",
  "version": "0.1.0",
  "private": true,
  "description": "上班摸鱼桌宠 —— 桌面悬浮小挂件 + 打卡 + 摸鱼收入统计",
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack": "node scripts/build.js",
    "pack:mobile": "node mobile/build.js && node scripts/pack-mobile.js",
    "mobile": "node mobile/build.js && node scripts/open-mobile.js",
    "mobile:open": "node scripts/open-mobile.js",
    "smoke": "node scripts/smoke.js",
    "test:chat": "node scripts/chat-test.js",
    "test": "node scripts/smoke.js && node scripts/chat-test.js"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^38.8.6",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
