{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面端默认能力：事件监听 + 拖拽把手 + 开机自启",
  "windows": [
    "pet",
    "panel",
    "chat",
    "chatpet",
    "petmenu"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
